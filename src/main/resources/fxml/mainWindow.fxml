<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dumpports.ui.MainWindowController">
    <top>
        <VBox spacing="0">
            <MenuBar>
                <Menu text="History">
                    <MenuItem fx:id="exportHistoryMenuItem" text="Export Connection History..." onAction="#onExportHistory"/>
                    <MenuItem fx:id="clearHistoryMenuItem" text="Clear Connection History" onAction="#onClearHistory"/>
                </Menu>
            </MenuBar>
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label fx:id="historyWarningLabel" text="" style="-fx-text-fill: orange; -fx-font-size: 11;" visible="false"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="privilegeModeLabel" text="🔒 User Mode" style="-fx-text-fill: #b8860b; -fx-font-size: 12; -fx-font-weight: bold;"/>
                    <Button fx:id="elevateButton" text="Run as Root" style="-fx-padding: 3 12;"/>
                    <ProgressIndicator fx:id="elevationIndicator" maxWidth="18" maxHeight="18" visible="false" managed="false"/>
                </HBox>
                <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT" prefWrapLength="900" style="-fx-padding: 0 0 10 0;">
                    <Label text="Protocol Filter:" style="-fx-font-size: 12;"/>
                    <ComboBox fx:id="protocolFilterCombo" prefWidth="120"/>
                    <Button fx:id="refreshButton" text="Refresh" style="-fx-padding: 5 15;"/>
                    <CheckBox fx:id="autoRefreshCheck" text="Auto Refresh" selected="false"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Interval (s):"/>
                        <Spinner fx:id="refreshIntervalSpinner" editable="true"/>
                    </HBox>
                    <Separator orientation="VERTICAL"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Search:"/>
                        <TextField fx:id="searchField" promptText="Type to search..." prefWidth="160"/>
                    </HBox>
                    <Label text="Port Range:"/>
                    <TextField fx:id="minPortField" promptText="Min" prefWidth="50"/>
                    <TextField fx:id="maxPortField" promptText="Max" prefWidth="50"/>
                    <ComboBox fx:id="portTypeCombo" prefWidth="90">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Local"/>
                                <String fx:value="Remote"/>
                                <String fx:value="Both"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <Separator orientation="VERTICAL"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Address Regex:"/>
                        <TextField fx:id="addressRegexField" promptText="e.g. ^192\\.168\\..*" prefWidth="140"/>
                    </HBox>
                <CheckBox fx:id="localAddressCheck" text="Local" selected="true"/>
                <CheckBox fx:id="remoteAddressCheck" text="Remote" selected="true"/>
                <Label fx:id="regexWarningLabel" text="" style="-fx-text-fill: red; -fx-font-size: 11;" visible="false"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="exportCSVButton" text="Export to CSV" style="-fx-padding: 5 15;"/>
                <Button fx:id="exportJSONButton" text="Export to JSON" style="-fx-padding: 5 15;"/>
                <ToggleButton fx:id="favoritesToggleButton" text="★ Favorites Only" onAction="#onFavoritesToggle" style="-fx-font-size: 14; -fx-padding: 5 14; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bba500; -fx-border-width: 1; -fx-background-color: linear-gradient(to bottom,#fffbe6,#ffe066); -fx-effect: dropshadow(gaussian, #e6c200, 2,0,0,1);"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ProgressIndicator fx:id="loadingIndicator" maxWidth="30" maxHeight="30" visible="false"/>
            </FlowPane>
            <Label fx:id="statusLabel" text="Ready" style="-fx-text-fill: #666666; -fx-font-size: 11;"/>
        </VBox>
    </VBox>
    </top>
    
    <center>
        <TableView fx:id="socketsTable" editable="false">
            <columns>
                <TableColumn fx:id="favoriteColumn" text="★" prefWidth="40"/>
                <TableColumn fx:id="protocolColumn" text="Protocol" prefWidth="70"/>
                <TableColumn fx:id="stateColumn" text="State" prefWidth="100"/>
                <TableColumn fx:id="localAddressColumn" text="Local Address" prefWidth="150"/>
                <TableColumn fx:id="localPortColumn" text="Local Port" prefWidth="80"/>
                <TableColumn fx:id="remoteAddressColumn" text="Remote Address" prefWidth="150"/>
                <TableColumn fx:id="remotePortColumn" text="Remote Port" prefWidth="80"/>
                <TableColumn fx:id="processColumn" text="Process" prefWidth="200"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
    
    <bottom>
        <HBox spacing="10" style="-fx-padding: 10; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
            <Label text="DumpPorts v1.0.0 - Socket Statistics Visualizer" style="-fx-text-fill: #666666; -fx-font-size: 10;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="socketCountLabel" text="Sockets: 0" style="-fx-text-fill: #666666; -fx-font-size: 10;"/>
        </HBox>
    </bottom>
</BorderPane>
